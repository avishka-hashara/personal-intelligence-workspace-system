# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app (public keys only).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Deployed Next.js backend (Vercel). Can also be changed later in the app's Settings screen.
EXPO_PUBLIC_API_URL=https://your-piw.vercel.app
